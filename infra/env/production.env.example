# Copy to infra/env/production.env, chmod 600. Never reuse development .env/data.
RELEASE_TAG=mvp-v1
# Canonical web FQDN/origin plus host LAN/VPN IP (direct-IP HTTPS is also enabled).
# IP-origin trust is derived from PUBLIC_BIND_IP; do not add a wildcard origin.
APP_DOMAIN=
APP_ORIGIN=
PUBLIC_BIND_IP=
HTTP_PORT=80
HTTPS_PORT=443
# Administrator chooses a free Docker CIDR (no LAN/VPN/DNS overlap).
# Exact Caddy address within that subnet; only this peer is trusted by the API.
APP_SUBNET=
# Sub-CIDR reserved for dynamic API/web addresses; excludes gateway/Caddy IP.
APP_DYNAMIC_RANGE=
CADDY_IPV4=
DATA_DIRECTORY=/var/lib/university-platform/data
BACKUP_DIRECTORY=/var/lib/university-platform/backups
# Absolute host paths. Public AD CA PEM; password file readable only by UID 1000.
AD_CA_CERT_FILE=
AD_BIND_PASSWORD_FILE=
AD_URL=
AD_BASE_DN=
AD_BIND_DN=
# Optional override; default is CN=Domain Admins,CN=Users,<AD_BASE_DN>.
AD_DOMAIN_ADMINS_GROUP_DN=
AD_LOGIN_ATTRIBUTE=sAMAccountName
AD_CONNECT_TIMEOUT_MS=5000
AD_OPERATION_TIMEOUT_MS=10000
AD_RECHECK_SECONDS=300
# Inactivity and absolute session limits; one week (168 hours).
SESSION_IDLE_HOURS=168
SESSION_ABSOLUTE_HOURS=168
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
LOG_LEVEL=info
# Directory exists even in internal-CA mode; never put keys in Git.
WEB_TLS_DIRECTORY=/var/lib/university-platform/certs/web
# internal = Caddy internal CA, distribute its public root to university clients.
# Institutional CA alternative: /etc/caddy/tls/server.crt and server.key.
CADDY_TLS_CERT=internal
CADDY_TLS_KEY=
