{
	admin off
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}
http://{$APP_DOMAIN} {
	redir {$APP_ORIGIN}{uri} permanent
}
https://{$APP_DOMAIN} {
	# Default is the internal CA. Institutional certificate: two PEM file paths.
	tls {$CADDY_TLS_CERT:internal} {$CADDY_TLS_KEY:}
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' wss://{http.request.hostport}; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
	@api path /api /api/*
	handle @api {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:3000 {
			# Caddy is the only ingress; do not preserve client-supplied proxy headers.
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		reverse_proxy web:8080
	}
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Csrf-Token delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}
