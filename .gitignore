coverage/
**/coverage/
*.lcov
playwright-report/
test-results/
blob-report/

# Older Postman phase exports duplicate the cumulative phase 8 contract.
# Keep the complete/current API collection and standalone feature collections.
postman/collections/University Phase [1-7]/

