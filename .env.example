NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000
APP_ORIGIN=http://localhost:5173
# Relative to apps/api for all pnpm --filter api commands.
DATABASE_URL=./data/university.sqlite
BACKUP_DIRECTORY=./backups
AUTH_PROVIDER=local
# Optional password-free entry, ONLY development + loopback + existing CLI user.
DEV_ACCESS_ENABLED=false
DEV_ACCESS_USERNAME=
AD_URL=
AD_BASE_DN=
AD_BIND_DN=
AD_BIND_PASSWORD=
# Alternative private absolute file; never set both sources.
AD_BIND_PASSWORD_FILE=
AD_CA_CERT_PATH=
AD_LOGIN_ATTRIBUTE=sAMAccountName
AD_CONNECT_TIMEOUT_MS=5000
AD_OPERATION_TIMEOUT_MS=10000
AD_RECHECK_SECONDS=300
SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_HOURS=24
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
# Empty = no trusted proxy. Production: exact Caddy IP/CIDR, never true.
TRUST_PROXY=
LOG_LEVEL=info
